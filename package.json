{
  "name": "@javinfo/mcp",
  "version": "0.0.1",
  "description": "MCP server placeholder for javinfo. Code coming soon.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "echo \"build pending\"",
    "release": "release-it"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javinfo/mcp.git"
  },
  "keywords": [
    "mcp",
    "javinfo"
  ],
  "devDependencies": {
    "release-it": "^17.10.0",
    "@release-it/conventional-changelog": "^8.0.1"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): v${version}"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": true,
      "skipChecks": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  }
}
